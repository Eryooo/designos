{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://designos.dev/schemas/feedback/diagnostic-summary.schema.json",
  "title": "Diagnostic Summary",
  "description": "Sanitized diagnostic summary for user feedback, must not contain original input, PRD text, screenshot OCR, URLs, credentials, local paths, or business confidential text.",
  "type": "object",
  "required": [
    "run_id",
    "run_workspace_id",
    "skill",
    "designos_version",
    "skill_version",
    "mode",
    "input_decision",
    "delivery_decision",
    "triggered_failure_modes",
    "linked_kr",
    "gap_count",
    "assumption_count",
    "sanitized_error_message",
    "created_at"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Run ID, e.g. RUN-YYYYMMDD-001-skill"
    },
    "run_workspace_id": {
      "type": "string",
      "description": "Run workspace ID (not path), e.g. RUN-YYYYMMDD-001-prd2proto"
    },
    "skill": {
      "type": "string",
      "enum": ["prd2proto", "uxeval", "ai-analytics", "ip-design", "brand-creative"]
    },
    "designos_version": {
      "type": "string"
    },
    "skill_version": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "input_decision": {
      "type": "string",
      "enum": ["ready", "ready_with_assumptions", "needs_user_clarification", "blocked_insufficient_input"]
    },
    "input_document_type": {
      "type": "string",
      "description": "S2-H9 FB-01: prd2proto 输入文档类型分类",
      "enum": ["prd", "mrd", "roadmap", "strategy_brief", "mixed", "unknown"]
    },
    "input_document_type_confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "can_generate_prototype_from_input": {
      "type": "string",
      "description": "S2-H9 FB-01: prd2proto 是否可从当前输入生成完整 prototype",
      "enum": ["yes", "partial", "no"]
    },
    "evidence_type": {
      "type": "string",
      "description": "S2-H9 FB-02: uxeval 证据类型分类",
      "enum": ["product_ui_screenshot", "web_capture", "prototype_capture", "document_screenshot", "pdf_page_image", "prd_text", "mixed", "unknown"]
    },
    "evidence_type_confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "can_support_ux_evaluation": {
      "type": "string",
      "description": "S2-H9 FB-02: uxeval 当前证据是否可支持完整 UX 评估",
      "enum": ["yes", "partial", "no"]
    },
    "checkpoint_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["checkpoint_id", "decision"],
        "properties": {
          "checkpoint_id": {"type": "string"},
          "decision": {
            "type": "string",
            "enum": ["continue", "continue_with_gaps", "ask_user", "degrade_scope", "stop_blocked"]
          }
        }
      }
    },
    "delivery_decision": {
      "type": "string",
      "enum": ["pass", "pass_with_minor_warnings", "degrade_with_gaps", "block"]
    },
    "consistency_decision": {
      "type": "string",
      "enum": ["consistent", "consistent_with_carried_gaps", "needs_reconciliation", "blocked_inconsistent"]
    },
    "triggered_failure_modes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "linked_kr": {
      "type": "array",
      "items": {"type": "string"}
    },
    "gap_count": {
      "type": "integer",
      "minimum": 0
    },
    "assumption_count": {
      "type": "integer",
      "minimum": 0
    },
    "error_type": {
      "type": "string"
    },
    "sanitized_error_message": {
      "type": "string",
      "description": "Error message with sensitive content removed"
    },
    "reproduction_hint_sanitized": {
      "type": "string",
      "description": "Reproduction hint with paths, names, and business content removed"
    },
    "evidence_ref": {
      "type": "string",
      "description": "Optional evidence reference ID only (not path), e.g. PRIVATE-EVIDENCE-YYYYMMDD-001"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "recommended_missing_fields": {
      "type": "array",
      "description": "S2-H7.1: Recommended fields to fill input gaps",
      "items": {
        "type": "object",
        "required": ["field_category", "recommended_field", "why_important", "can_continue_without"],
        "properties": {
          "field_category": {"type": "string"},
          "recommended_field": {"type": "string"},
          "why_important": {"type": "string"},
          "minimum_needed_to_continue": {"type": "string"},
          "can_continue_without": {"type": "boolean"}
        }
      }
    },
    "recommended_user_questions": {
      "type": "array",
      "description": "S2-H7.1: Questions to ask user to fill gaps",
      "items": {
        "type": "object",
        "required": ["question_id", "question", "blocking_level"],
        "properties": {
          "question_id": {"type": "string"},
          "question": {"type": "string"},
          "expected_answer_format": {"type": "string"},
          "blocking_level": {
            "type": "string",
            "enum": ["blocker", "major", "minor"]
          },
          "linked_gap": {"type": "string"}
        }
      }
    },
    "kr_summary": {
      "type": "object",
      "description": "S2-H7.1: KR aggregation view",
      "properties": {
        "total_kr": {"type": "integer", "minimum": 0},
        "pass_count": {"type": "integer", "minimum": 0},
        "warn_count": {"type": "integer", "minimum": 0},
        "fail_count": {"type": "integer", "minimum": 0},
        "unknown_count": {"type": "integer", "minimum": 0},
        "affected_kr": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kr_id", "status"],
            "properties": {
              "kr_id": {"type": "string"},
              "status": {
                "type": "string",
                "enum": ["pass", "warn", "fail", "unknown"]
              },
              "linked_gate": {"type": "string"},
              "impact_level": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              }
            }
          }
        },
        "most_affected_kr": {
          "type": "array",
          "description": "Top 1-3 most affected KR with reasons",
          "items": {
            "type": "object",
            "required": ["kr_id", "reason"],
            "properties": {
              "kr_id": {"type": "string"},
              "reason": {"type": "string"}
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
